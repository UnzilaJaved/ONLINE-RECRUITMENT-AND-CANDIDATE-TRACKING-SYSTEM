function getStatusStyle(status) {
  if (status === "Shortlisted") {
    return { bg: "#dcfce7", text: "#166534" };
  }
  if (status === "Interview Scheduled") {
    return { bg: "#ede9fe", text: "#5b21b6" };
  }
  return { bg: "#dbeafe", text: "#1d4ed8" };
}

